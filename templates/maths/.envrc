# The maths workspace's Python comes from a Nix dev shell that direnv builds the
# first time this folder is used (a few minutes; later opens are instant).
#
# It is rebuilt automatically the first time the folder is used after going a
# week without a rebuild, so improvements arrive without anyone having to ask
# for them. If the rebuild fails (for example there is no internet), the
# previous environment keeps working and the rebuild is tried again next time.
mkdir -p .direnv
if [ -z "$(find .direnv -maxdepth 1 -name refreshed -mtime -7 2>/dev/null)" ]; then
  touch .direnv/refreshed
fi
watch_file .direnv/refreshed

# MATHS_FLAKE_REF lets whoever looks after this machine try a different branch
# or a local checkout of the shell definition without editing this file
# (it must name the maths/ flake, e.g. git+file:///path/to/nixos?dir=maths).
use flake "${MATHS_FLAKE_REF:-github:dc0d32/nixos?dir=maths}"

# A stable path inside the folder, so VS Code always finds the interpreter. Only
# link a real Nix Python, never whatever else happens to be on PATH.
if py="$(command -v python)"; then
  case "$py" in
    /nix/store/*) ln -sfn "$(dirname "$(dirname "$py")")" .direnv/python ;;
  esac
fi
