#!/usr/bin/env python3
"""graphify-nix — run graphify with (basic) Nix `.nix` extraction.

graphify (graphifyy) ships no Nix tree-sitter grammar/config, so `.nix` files are
ignored entirely and the code graph is built from markdown only. This wrapper
monkeypatches graphify at runtime to (1) classify `.nix` as code and (2) register
a tree-sitter-nix `LanguageConfig`, then delegates to graphify's normal CLI.

Kept IN-REPO (not patched into site-packages) so it survives `uv tool upgrade
graphifyy`. The shebang is portable `#!/usr/bin/env python3`; if graphify isn't
importable under that interpreter, the bootstrap below RE-EXECS this script under
graphify's own venv python — discovered from the `graphify` launcher on PATH (or
~/.local/bin/graphify), NOT a hardcoded user/tool path.

Prereq (one-time, records the grammar as a --with dep so it survives reinstall):
    uv tool install graphifyy --with tree-sitter-nix

Usage (same args as graphify):
    scripts/graphify-nix update .
    scripts/graphify-nix query "..."

STATUS: recognizes `.nix` as code and emits a file node + the top-level
module-function node per file, PLUS file->file `import` edges (the module DAG)
and file->callee `calls` edges for nixpkgs primitives (`lib.*`/`pkgs.*`/
`builtins.*`). Still NOT done: attribute-binding nodes (`flake.modules.*`,
`options.*`), in-repo helper call resolution, and the dendritic feature graph.
See the `graphify-nix-*` todos / docs/graphify-nix-handoff.md for the full spec.
"""
import os
import shutil
import sys


def _graphify_python():
    """Resolve the interpreter of graphify's venv by reading the shebang of the
    `graphify` launcher (PATH first, then ~/.local/bin). Tool-name/user-path
    agnostic: works for any uv-tool / pipx / venv install."""
    exe = shutil.which("graphify") or os.path.expanduser("~/.local/bin/graphify")
    try:
        with open(exe, "rb") as fh:
            first = fh.readline().decode("utf-8", "replace").strip()
    except OSError:
        return None
    if first.startswith("#!"):
        interp = first[2:].strip().split()[0]
        # skip an `env` shebang (no fixed interpreter to reuse)
        if interp and os.path.basename(interp) != "env" and os.path.exists(interp):
            return interp
    return None


try:
    import graphify  # noqa: F401
except ImportError:
    _py = _graphify_python()
    # Re-exec via graphify's venv python. NOTE: don't compare realpaths — a venv
    # python often shares the same underlying binary as the system python, yet
    # invoking it via the VENV path is what puts graphify's site-packages on
    # sys.path. A sentinel env var prevents any re-exec loop.
    if _py and not os.environ.get("_GRAPHIFY_NIX_REEXEC"):
        os.environ["_GRAPHIFY_NIX_REEXEC"] = "1"
        os.execv(_py, [_py, os.path.abspath(__file__), *sys.argv[1:]])
    sys.exit(
        "graphify-nix: could not locate graphify's Python env. Install with:\n"
        "  uv tool install graphifyy --with tree-sitter-nix"
    )

try:
    import tree_sitter_nix  # noqa: F401
except ImportError:
    sys.exit(
        "graphify-nix: tree-sitter-nix not installed in graphify's env. Run:\n"
        "  uv tool install graphifyy --with tree-sitter-nix"
    )

from graphify import detect, extract
from graphify.extract import LanguageConfig, _extract_generic

# 1. treat .nix as code (so the file walker extracts instead of skipping)
detect.CODE_EXTENSIONS.add(".nix")

# 2. minimal Nix language config. tree-sitter-nix node types of interest:
#    binding (attrpath=expression), function_expression (lambdas),
#    apply_expression (function+argument = a "call"), select_expression
#    (attr access, e.g. lib.mkForce), import ./x = apply(function=import).
#    Meaningful nodes come from `binding` (e.g. flake.modules.homeManager.ai-cli).
#    KNOWN COSMETIC ARTEFACT: each file's anonymous top-level module lambda
#    ({ lib, ... }: …) still gets a `{ ... }()` label. That name is built by
#    graphify's own `_extract_generic` internals (NOT `_resolve_name` /
#    name_fallback_child_types, which the generic path doesn't use), so it can't
#    be cleaned from this wrapper's config — it needs a change upstream in
#    graphify. Tracked in the graphify-nix-* todos / handoff doc.
_NIX_CONFIG = LanguageConfig(
    ts_module="tree_sitter_nix",
    ts_language_fn="language",
    function_types=frozenset({"function_expression", "binding"}),
    call_types=frozenset({"apply_expression", "select_expression"}),
    call_function_field="function",
    call_accessor_node_types=frozenset({"select_expression"}),
    call_accessor_field="attrpath",
    call_accessor_object_field="expression",
    name_field="attrpath",
    name_fallback_child_types=("attrpath", "identifier"),
    body_field="body",
    body_fallback_child_types=(
        "attrset_expression", "let_expression", "expression", "apply_expression",
    ),
    function_boundary_types=frozenset({"function_expression"}),
    function_label_parens=False,
)

extract._DISPATCH[".nix"] = lambda path: _extract_nix(path)


# ── Import edges (the module DAG) — the highest-value Nix output ───────────────
# Nix has no `import` node type and `_extract_generic`'s import_handler path
# never fires for it, so we post-process the tree ourselves and append file->file
# "imports" edges. Two forms:
#   * `import ./x.nix`         → apply_expression(function=variable "import",
#                                 argument=path_expression)   (anywhere)
#   * `imports = [ ./a.nix … ]`→ binding(attrpath="imports").expression =
#                                 list_expression with bare path_expression items
# Endpoints are keyed on `make_id(str(path.resolve()))` — the SAME raw
# (pre-remap) id extract() assigns a FILE node and registers in its id_remap
# table (it maps make_id(str(path)) AND make_id(str(path.resolve())) → the
# canonical repo-relative id for every scanned file). Because both our edge
# endpoints are those exact keys, extract()'s id-remap post-pass rewrites them
# to canonical form in lockstep with the file nodes — so the edges connect.
# (NB: the file node's raw id keeps the extension; the extension-less
# _file_stem form is only the prefix for that file's *symbol* nodes.)
from graphify.ids import make_id as _make_id  # noqa: E402
from graphify.extractors.base import _read_text  # noqa: E402

_NIX_PARSER = None


def _nix_parser():
    global _NIX_PARSER
    if _NIX_PARSER is None:
        from tree_sitter import Language, Parser
        _NIX_PARSER = Parser(Language(tree_sitter_nix.language()))
    return _NIX_PARSER


def _resolve_nix_import(src_path, rel_text):
    """Resolve a Nix path literal (./x, ../d/y.nix, ./dir) to a .nix file path
    IN THE SAME PATH SPACE as ``src_path`` (graphify walks with repo-relative
    paths and keys file nodes off that form, so the edge target must match it —
    NOT an absolute .resolve()). Existence is checked via the absolute path.
    Returns the path string (with .nix) or None. A bare dir → <dir>/default.nix."""
    import os
    rel_text = rel_text.strip()
    if not (rel_text.startswith("./") or rel_text.startswith("../") or rel_text.startswith("/")):
        return None  # not a path literal (e.g. <nixpkgs> or an attr ref)
    base = os.path.dirname(str(src_path))
    joined = os.path.normpath(os.path.join(base, rel_text))  # keeps src_path's space
    for cand in (joined, joined + ".nix", os.path.join(joined, "default.nix")):
        # existence check needs a real filesystem path
        ap = cand if os.path.isabs(cand) else os.path.join(os.getcwd(), cand)
        if os.path.isfile(ap):
            return cand
    return None


def _extract_nix(path):
    """Generic extraction + Nix import/call-edge post-processing."""
    from pathlib import Path
    result = _extract_generic(path, _NIX_CONFIG)
    p = Path(path)
    try:
        source = p.read_bytes()
        tree = _nix_parser().parse(source)
    except Exception:  # unreadable/unparseable — leave the base result untouched
        return result
    for _pass in (_append_nix_import_edges, _append_nix_call_edges):
        try:
            _pass(p, source, tree, result)
        except Exception:  # never let one edge pass break the base graph / the other
            pass
    return result


def _append_nix_import_edges(p, source, tree, result):
    from pathlib import Path
    file_nid = _make_id(str(p.resolve()))
    edges = result.setdefault("edges", [])
    seen = set()

    def emit(target_path, line):
        tgt = _make_id(str(Path(target_path).resolve()))
        key = (tgt, line)
        if tgt == file_nid or key in seen:
            return
        seen.add(key)
        edges.append({
            "source": file_nid,
            "target": tgt,
            "relation": "imports",
            "context": "import",
            "confidence": "EXTRACTED",
            "source_file": str(p),
            "source_location": f"L{line}",
            "weight": 1.0,
        })

    def is_import_call(node):
        if node.type != "apply_expression":
            return None
        fn = node.child_by_field_name("function")
        arg = node.child_by_field_name("argument")
        if fn is not None and arg is not None and fn.type == "variable_expression" \
                and _read_text(fn, source) == "import" and arg.type == "path_expression":
            return arg
        return None

    def walk(node):
        # form 1: `import ./x` anywhere
        arg = is_import_call(node)
        if arg is not None:
            r = _resolve_nix_import(p, _read_text(arg, source))
            if r:
                emit(r, node.start_point[0] + 1)
        # form 2: bare paths in an `imports = [ … ]` value. The value may be a
        # bare list OR a binary_expression like `[ … ] ++ bundles ++ [ … ]`, so
        # gather path items from EVERY list_expression under the binding.
        if node.type == "binding":
            ap = node.child_by_field_name("attrpath")
            expr = node.child_by_field_name("expression")
            if ap is not None and expr is not None and _read_text(ap, source) == "imports":
                stack = [expr]
                while stack:
                    n = stack.pop()
                    if n.type == "list_expression":
                        for item in n.children:
                            if item.type == "path_expression":
                                r = _resolve_nix_import(p, _read_text(item, source))
                                if r:
                                    emit(r, item.start_point[0] + 1)
                    else:
                        stack.extend(n.children)
        for c in node.children:
            walk(c)

    walk(tree.root_node)


# ── Call edges (nixpkgs primitive usage) ──────────────────────────────────────
# Emit file->callee "calls" edges for `apply_expression`s whose callee is a
# dotted select rooted at a nixpkgs namespace we can name unambiguously WITHOUT
# scope analysis: `lib.*`, `pkgs.*`, `builtins.*` (e.g. lib.mkForce,
# lib.mkDefault, pkgs.writeShellApplication, builtins.readFile). The callee is a
# SYNTHETIC concept node (id `nixcall:<dotted>`) shared across the whole graph —
# G.add_node() is idempotent by id, so the same callee emitted from many files
# collapses to one node, giving a "which modules use this primitive" view (handy
# for the repo's mkForce-vs-mkDefault policy concerns + per-module pkgs usage).
#
# Endpoints: the edge SOURCE is the file node's raw id (remapped to canonical by
# extract()'s id-remap post-pass, exactly like import edges); the TARGET synthetic
# id is NOT a file path so it survives the post-pass untouched — the node we add
# carries the same id, so no ghost.
#
# DEFERRED (needs binding/scope nodes — the `graphify-nix-bindings` todo): bare
# in-repo helper calls (`renderUserConf`, `validateUser`, let-bound lambdas) and
# `config.*`/`inputs.*` references, which can't be resolved to a definition node
# until we emit binding nodes to point them at.
_NIX_CALL_NAMESPACES = frozenset({"lib", "pkgs", "builtins"})


def _append_nix_call_edges(p, source, tree, result):
    file_nid = _make_id(str(p.resolve()))
    nodes = result.setdefault("nodes", [])
    edges = result.setdefault("edges", [])
    seen_edges = set()   # (callee_id) — one edge per callee per file
    seen_nodes = set()   # callee_ids already added in THIS file's result

    def callee_name(apply_node):
        """Head callee of an apply chain, if it's a lib/pkgs/builtins select."""
        head = apply_node.child_by_field_name("function")
        while head is not None and head.type == "apply_expression":
            head = head.child_by_field_name("function")
        if head is None or head.type != "select_expression":
            return None
        text = _read_text(head, source)
        # a multi-line/whitespaced select is rare; normalize interior whitespace
        text = " ".join(text.split())
        root = text.split(".", 1)[0]
        if root not in _NIX_CALL_NAMESPACES:
            return None
        return text

    def emit(name, line):
        cid = _make_id("nixcall:" + name)
        if cid not in seen_nodes:
            seen_nodes.add(cid)
            nodes.append({
                "id": cid,
                "label": name,
                "file_type": "concept",
                "source_file": "",
                "_origin": "ast",
            })
        if cid in seen_edges:
            return
        seen_edges.add(cid)
        edges.append({
            "source": file_nid,
            "target": cid,
            "relation": "calls",
            "context": "call",
            "confidence": "EXTRACTED",
            "source_file": str(p),
            "source_location": f"L{line}",
            "weight": 1.0,
        })

    def walk(node):
        if node.type == "apply_expression":
            name = callee_name(node)
            if name is not None:
                emit(name, node.start_point[0] + 1)
        for c in node.children:
            walk(c)

    walk(tree.root_node)


from graphify.__main__ import main  # noqa: E402

sys.exit(main())
